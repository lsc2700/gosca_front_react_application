{
  "cli": {
    "version": ">= 12.5.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "ios": {
        "simulator": true
      },
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "gosca"
      }
    },
    "preview-lchayim": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "lchayim"
      }
    },
    "preview-anding": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "anding"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
