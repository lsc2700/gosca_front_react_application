{
  "cli": {
    "version": ">= 12.5.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "ios": {
        "simulator": true
      },
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "gosca"
      }
    },
    "preview-lchayim": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "lchayim"
      }
    },
    "preview-anding": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "anding"
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "local",
      "env": {
        "APP_VARIANT": "gosca"
      }
    },
    "production-play": {
      "extends": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "gosca",
        "ANDROID_STORE_PACKAGE": "com.user.gosca"
      }
    },
    "production-lchayim": {
      "extends": "production",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "lchayim"
      }
    },
    "production-anding": {
      "extends": "production",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "anding"
      }
    },
    "production-lchayim-ios": {
      "extends": "production-lchayim",
      "credentialsSource": "local"
    },
    "production-anding-ios": {
      "extends": "production-anding",
      "credentialsSource": "local"
    }
  },
